# 人民数据城市词元工厂 - 生产环境配置示例
#
# 使用方法:
#   1. 复制此文件为 .env.prod:  cp .env.prod.example .env.prod
#   2. 修改下方所有配置项
#   3. 启动服务: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠️  重要安全提示:
#   - 请务必修改所有默认密码
#   - 使用强密码（至少 16 位，包含大小写字母、数字和特殊字符）
#   - 不要将 .env.prod 文件提交到 Git 仓库

# ============================================================================
# 应用配置
# ============================================================================

# 应用访问端口（默认 3000）
APP_PORT=3000

# 时区设置
TZ=Asia/Shanghai

# ============================================================================
# 数据库配置 - PostgreSQL
# ============================================================================

# 数据库用户名
POSTGRES_USER=newapi

# 数据库密码 ⚠️ 必须修改
# 建议使用强密码，例如: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_TO_STRONG_ONE

# 数据库名称
POSTGRES_DB=newapi_db

# 数据库端口（如需外部访问，取消 docker-compose.prod.yml 中的端口映射注释）
POSTGRES_PORT=5432

# ============================================================================
# Redis 配置
# ============================================================================

# Redis 密码 ⚠️ 必须修改
# 建议使用强密码，例如: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_TO_STRONG_ONE

# Redis 端口（如需外部访问，取消 docker-compose.prod.yml 中的端口映射注释）
REDIS_PORT=6379

# ============================================================================
# 应用安全配置
# ============================================================================

# 会话密钥 ⚠️ 必须修改
# 必须是 32 位以上的随机字符串
# 生成方法: openssl rand -base64 48
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_STRING_MIN_32_CHARS_EXAMPLE_openssl_rand_base64_48

# 管理员初始密码 ⚠️ 必须修改
# 首次启动后请立即在系统中修改此密码
INITIAL_ROOT_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ============================================================================
# 可选：ClickHouse 日志存储配置
# ============================================================================
# 如果启用 ClickHouse（取消 docker-compose.prod.yml 中的注释），请配置以下项

# ClickHouse 数据库名
CLICKHOUSE_DB=newapi_logs

# ClickHouse 用户名
CLICKHOUSE_USER=default

# ClickHouse 密码 ⚠️ 如启用必须修改
CLICKHOUSE_PASSWORD=CHANGE_THIS_CLICKHOUSE_PASSWORD

# ClickHouse HTTP 端口
CLICKHOUSE_HTTP_PORT=8123

# ClickHouse Native 端口
CLICKHOUSE_NATIVE_PORT=9000

# ============================================================================
# 快速生成强密码的命令
# ============================================================================
#
# 在 Linux/macOS 终端执行以下命令生成随机密码:
#
# 方法 1 - 使用 openssl (推荐):
#   openssl rand -base64 32
#
# 方法 2 - 使用 /dev/urandom:
#   cat /dev/urandom | tr -dc 'a-zA-Z0-9!@#$%^&*' | fold -w 32 | head -n 1
#
# 方法 3 - 使用 pwgen (需先安装):
#   pwgen -s 32 1
#
# ============================================================================
# 配置示例（生产环境请替换为实际值）
# ============================================================================
#
# POSTGRES_PASSWORD=Kx9mZ2vL8nQ3wR5pT7yU4aB6cD1eF0gH
# REDIS_PASSWORD=Jh8nM4xK9zL2wQ6pT3yR5uB7cA1eD0fG
# SESSION_SECRET=Nm7kP4xJ9zL2wQ6pT3yR5uB8cA1eD0fG3hK5mN7xP9zL2w
# INITIAL_ROOT_PASSWORD=Admin@2024!SecurePassword
# CLICKHOUSE_PASSWORD=Qw8nM4xK9zL2wQ6pT3yR5uB7cA1eD0fG
#
# ============================================================================
